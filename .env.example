#App
NEXT_PUBLIC_APP_NAME=Estate AI Workflow
NODE_ENV=development

#Database (Docker Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estate_ai?schema=public

#Email sending
# "outbox" (default) records replies in the database only; nothing is sent.
# "smtp" relays to the local MailDev inbox (docker compose up -d maildev),
# viewable at http://localhost:1080. Non-local hosts are refused unless
# EMAIL_ALLOW_REMOTE_SMTP=true.
EMAIL_TRANSPORT=outbox
EMAIL_FROM="Estate AI Workflow <no-reply@estate-ai.local>"
SMTP_HOST=localhost
SMTP_PORT=1025

#AI (optional)
# Without a key the app runs on the rule-based engine only. With one, triage
# consults the language model when the rules are unsure, and drafts are personalised.
# AI_MODE=rules forces the rule engine even when a key is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_MODE=hybrid

#Demo protection (optional)
# Set both to require a username and password for every page and API route,
# e.g. on a hosted demo. Leave empty for local development.
DEMO_USER=
DEMO_PASSWORD=
