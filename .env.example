#App
NEXT_PUBLIC_APP_NAME=Estate AI Workflow
NODE_ENV=development

#Database (Docker Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estate_ai?schema=public

#Email sending
# "outbox" (default) records replies in the database only; nothing is sent.
# "smtp" relays to the local MailDev inbox (docker compose up -d maildev),
# viewable at http://localhost:1080. Non-local hosts are refused unless
# EMAIL_ALLOW_REMOTE_SMTP=true.
EMAIL_TRANSPORT=outbox
EMAIL_FROM="Estate AI Workflow <no-reply@estate-ai.local>"
SMTP_HOST=localhost
SMTP_PORT=1025

#LLM (Optional)
OPENAI_API_KEY=
