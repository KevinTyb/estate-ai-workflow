generator client {
  provider = "prisma-client-js"
  // output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Slot {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endAt      DateTime
  isBooked   Boolean   @default(false)
  bookings   Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, startsAt, endAt])
  @@index([propertyId, startsAt])
}

model Property {
  id        String    @id @default(cuid())
  ref       String    @unique //e.g. "BST-12A"
  address   String
  postcode  String?
  bedrooms  Int?
  rentPcm   Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  enquiries Enquiry[]
  slots     Slot[]
}

model Enquiry {
  id          String        @id @default(cuid())
  rawText     String
  source      String //"email" | "web" |"phone"
  status      EnquiryStatus @default(PENDING)
  intent      Intent?
  contactName String?
  email       String?
  phone       String?

  propertyRef String?

  propertyId     String?
  property       Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  triageResult   triageResult?
  draftReply     DraftReply?
  bookings       Booking[]
  outboundEmails OutboundEmail[]
  events         EnquiryEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([propertyId])
  @@index([createdAt])
}

model DraftReply {
  id        String  @id @default(cuid())
  enquiryId String  @unique
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  subject   String?
  body      String
  method    String
  /// True when the agent changed the generated text before approving it.
  edited    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model triageResult {
  id        String  @id @default(cuid())
  enquiryId String  @unique
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  intent       Intent?
  confidence   Float?
  entities     Json?
  method       String  @default("rules") //"rules" | "llm" | "rules-fallback"
  /// Set when a person should check the classification before acting.
  needsReview  Boolean @default(false)
  reviewReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A confirmed (or cancelled) viewing appointment for an enquiry.
model Booking {
  id        String        @id @default(cuid())
  enquiryId String
  enquiry   Enquiry       @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  slotId    String
  slot      Slot          @relation(fields: [slotId], references: [id], onDelete: Restrict)
  status    BookingStatus @default(CONFIRMED)
  notes     String?

  /// Equals slotId while the booking is CONFIRMED and is cleared on
  /// cancellation. The unique index makes the database itself reject a
  /// second confirmed booking for the same slot, even under concurrency.
  activeSlotId String? @unique

  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([enquiryId])
  @@index([slotId])
}

/// A reply sent to a customer. With the default "outbox" transport nothing
/// leaves the system: the message is only recorded here.
///
/// The row is written as SENDING before the transport is called, so a
/// concurrent or repeated request for the same approved draft is refused
/// instead of sending the reply twice.
model OutboundEmail {
  id        String              @id @default(cuid())
  enquiryId String
  enquiry   Enquiry             @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  toEmail   String
  subject   String
  body      String
  transport String //"outbox" | "smtp"
  messageId String?
  status    OutboundEmailStatus @default(SENT)

  /// One send per approved draft version. Unique, so two requests cannot
  /// both claim the same draft.
  idempotencyKey String?  @unique
  /// When the current attempt started. A SENDING claim older than the
  /// timeout is moved to UNKNOWN, not retried.
  claimedAt      DateTime @default(now())
  failureReason  String?

  /// Time the transport accepted the message (claim time until then).
  sentAt DateTime @default(now())

  @@index([enquiryId, sentAt])
}

enum OutboundEmailStatus {
  SENDING
  SENT
  FAILED
  /// The attempt was interrupted after the transport may have accepted the
  /// message. Never retried automatically: an agent must confirm a resend
  /// or mark it as sent.
  UNKNOWN
}

/// Append-only audit trail of workflow actions; analytics are computed
/// from these timestamps rather than from assumed time savings.
model EnquiryEvent {
  id        String    @id @default(cuid())
  enquiryId String
  enquiry   Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  type      EventType
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([enquiryId, createdAt])
  @@index([type, createdAt])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum EventType {
  TRIAGED
  DRAFT_GENERATED
  DRAFT_APPROVED
  EMAIL_SENT
  VIEWING_BOOKED
  BOOKING_CANCELLED
}

enum EnquiryStatus {
  PENDING
  DRAFTED
  SENT
  SCHEDULED
  CLOSED
}

enum Intent {
  VIEWING
  VALUATION
  MAINTENANCE
  GENERAL
  SPAM
}
